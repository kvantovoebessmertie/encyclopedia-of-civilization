{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvantovoebessmertie.github.io/encyclopedia-of-civilization/schema/record.schema.json",
  "title": "Энциклопедия цивилизации — каноническая Record",
  "description": "Каноническая JSON Schema первого и расширенного машиночитаемого вертикального среза. Реализованы профили record, claim, source, evidence_use, assessment, inference, decision, action, event и result. Структурная валидация не доказывает истинность, качество свидетельства, корректность вывода, решения, действия или причинность.",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "record_version",
    "type_version",
    "publication_status",
    "schema",
    "provenance",
    "content"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Устойчивый идентификатор логической Record."
    },
    "record_type": {
      "type": "string",
      "enum": [
        "record",
        "claim",
        "source",
        "evidence_use",
        "assessment",
        "inference",
        "decision",
        "action",
        "event",
        "result",
        "state",
        "process",
        "relation",
        "identity",
        "context",
        "scope",
        "provenance",
        "authorship_contribution",
        "trust_reputation"
      ],
      "description": "Явный идентификатор зарегистрированного типа Record."
    },
    "record_version": {
      "type": "string",
      "minLength": 1,
      "description": "Идентификатор конкретной версии Record; не равен record_id, type_version или schema_version."
    },
    "content": {
      "type": "object",
      "description": "Специализированное содержимое. Для реализованных профилей первой схемы его структура определяется record_type."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "created_at": {
      "$ref": "#/$defs/time_point",
      "description": "Время создания Record, не являющееся автоматически временем действительности содержания."
    },
    "updated_at": {
      "$ref": "#/$defs/time_point",
      "description": "Время технического изменения Record."
    },
    "valid_time": {
      "$ref": "#/$defs/time_interval",
      "description": "Время действительности содержания, если применимо."
    },
    "scope": {
      "$ref": "#/$defs/record_ref"
    },
    "context": {
      "$ref": "#/$defs/record_ref"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      },
      "uniqueItems": true
    },
    "type_version": {
      "type": "string",
      "minLength": 1,
      "description": "Версия семантического Type Profile; отличается от record_version и schema."
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "proposal",
        "draft",
        "review",
        "published",
        "withdrawn",
        "archived"
      ],
      "description": "Публикационный статус Record; не является эпистемической оценкой."
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "description": "Идентификатор и версия структуры, которой соответствует Record; отличается от record_version и версии самой JSON Schema."
    }
  },
  "$defs": {
    "record_ref": {
      "type": "object",
      "required": [
        "record_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Структурная ссылка на Record. Отсутствие version означает ссылку на логическую Record, а не автоматически на текущую версию."
    },
    "external_ref": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "unknown_value": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "absent",
            "not_applicable",
            "not_observed",
            "not_recorded"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Явная семантика неизвестности/отсутствия; не является универсальной заменой null."
    },
    "time_point": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "$ref": "#/$defs/unknown_value"
        }
      ]
    },
    "time_interval": {
      "type": "object",
      "properties": {
        "start": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/$defs/unknown_value"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/$defs/unknown_value"
            }
          ]
        },
        "approximate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "start"
          ]
        },
        {
          "required": [
            "end"
          ]
        }
      ]
    },
    "material": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "fragment": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        {
          "$ref": "#/$defs/unknown_value"
        }
      ]
    },
    "extension": {
      "type": "object",
      "required": [
        "extension_id",
        "extension_version",
        "data"
      ],
      "properties": {
        "extension_id": {
          "type": "string",
          "minLength": 1
        },
        "extension_version": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "target_ref",
        "relation"
      ],
      "properties": {
        "target_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "agent_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "method_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "operation_status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "partial",
            "disputed"
          ]
        },
        "fidelity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "statement",
        "claim_type"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "type": "string",
          "minLength": 1
        },
        "referents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "scope_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "context_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "string",
          "minLength": 1
        },
        "relation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "external_ref": {
          "$ref": "#/$defs/external_ref"
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "preservation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "evidence_use": {
      "type": "object",
      "required": [
        "claim_ref",
        "source_ref",
        "material",
        "evidence_role"
      ],
      "properties": {
        "claim_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "source_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts"
          ]
        },
        "resolution_context": {
          "$ref": "#/$defs/record_ref"
        },
        "source_state_ref": {
          "$ref": "#/$defs/record_ref"
        }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "target",
        "aspect"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/record_ref"
        },
        "aspect": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "result": {},
        "uncertainty": {},
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "assessor_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "method_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "scale_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "profile_ref": {
          "$ref": "#/$defs/record_ref"
        }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": [
        "conclusion",
        "attribution"
      ],
      "properties": {
        "premises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "conclusion": {},
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "rule_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "model_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "procedure_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "attribution": {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "reconstructed"
              ]
            },
            "agent_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "method_ref": {
              "$ref": "#/$defs/record_ref"
            }
          }
        },
        "uncertainty": {},
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_result",
        "decision_maker"
      ],
      "properties": {
        "decision_result": {},
        "decision_space": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alternatives": {
              "type": "array",
              "items": {}
            },
            "constraints": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "decision_maker": {
          "$ref": "#/$defs/record_ref"
        },
        "context_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "scope_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "authority_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "process_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "action_content"
      ],
      "properties": {
        "action_content": {},
        "performer_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "context_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "scope_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "intention": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "type": "string",
          "enum": [
            "intended",
            "attempted",
            "partial",
            "completed",
            "unknown",
            "not_applicable"
          ]
        },
        "time": {
          "$ref": "#/$defs/time_interval"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "procedure_ref": {
          "$ref": "#/$defs/record_ref"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "event_content"
      ],
      "properties": {
        "event_content": {},
        "time": {
          "$ref": "#/$defs/time_interval"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "observation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "cause_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "certainty": {},
        "event_status": {
          "type": "string",
          "enum": [
            "observed",
            "reported",
            "reconstructed",
            "predicted",
            "planned",
            "disputed",
            "unknown"
          ]
        },
        "context_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "scope_ref": {
          "$ref": "#/$defs/record_ref"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "result_content",
        "reference_frame"
      ],
      "properties": {
        "result_content": {},
        "reference_frame": {
          "type": "object",
          "required": [
            "refs"
          ],
          "properties": {
            "refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/record_ref"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "time": {
          "$ref": "#/$defs/time_interval"
        },
        "scope_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "observation_scope_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "comparison_reference": {
          "$ref": "#/$defs/record_ref"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "observed",
              "measured",
              "computed",
              "inferred",
              "reconstructed",
              "modeled",
              "assessed",
              "reported"
            ]
          },
          "uniqueItems": true
        },
        "expectation": {
          "type": "string",
          "enum": [
            "expected",
            "not_expected",
            "unknown",
            "not_applicable"
          ]
        },
        "intention": {
          "type": "string",
          "enum": [
            "intended",
            "unintended",
            "unknown",
            "not_applicable"
          ]
        },
        "desirability": {
          "type": "string",
          "enum": [
            "desired",
            "undesired",
            "neutral",
            "unknown",
            "not_applicable"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "preliminary",
            "partial",
            "final",
            "revised",
            "historical",
            "unknown"
          ]
        },
        "causal_attribution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "attributed",
                "not_attributed",
                "uncertain",
                "unknown"
              ]
            },
            "basis_ref": {
              "$ref": "#/$defs/record_ref"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "state_content",
        "subject_ref"
      ],
      "properties": {
        "state_content": {},
        "subject_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "frame_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "time": {
          "$ref": "#/$defs/time_interval"
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "historical",
            "snapshot",
            "unknown"
          ]
        },
        "observation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "required": [
        "process_content"
      ],
      "properties": {
        "process_content": {},
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        },
        "context_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "time": {
          "$ref": "#/$defs/time_interval"
        },
        "start_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "end_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "phase_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "relation_type",
        "participants"
      ],
      "properties": {
        "relation_type": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "minItems": 2
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "directed",
            "undirected",
            "unknown"
          ]
        },
        "frame_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "valid_time": {
          "$ref": "#/$defs/time_interval"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "identity_level",
        "targets",
        "criterion"
      ],
      "properties": {
        "identity_level": {
          "type": "string",
          "minLength": 1
        },
